---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';

const lessons = (await getCollection('blog'))
  .filter((entry) => /^day-\d+$/.test(entry.id))
  .sort((a, b) => a.id.localeCompare(b.id));
---

<!doctype html>
<html lang="en">
  <head><BaseHead title="All Go Lessons | Go Journey" description={SITE_DESCRIPTION}/></head>
  <body>
    <Header />
    <main class="lesson-index">
      <a class="back" href="/">← Home</a>
      <div class="intro"><p class="eyebrow">LEARNING LIBRARY</p><h1>All Go lessons</h1><p>Browse the curriculum in order, or search for a concept you want to revisit.</p></div>
      <label class="search-label" for="lesson-search">Search lessons</label>
      <input id="lesson-search" type="search" placeholder="Try pointers, JSON, slices, interfaces…" autocomplete="off"/>
      <p class="no-results" hidden>No lessons match your search.</p>
      <ol class="lesson-list">
        {lessons.map((entry, index) => (
          <li data-lesson data-search={(entry.data.title + ' ' + entry.data.description).toLowerCase()}>
            <a href={'/blog/' + entry.id + '/'}>
              <span class="num">{String(index + 1).padStart(2, '0')}</span>
              <span class="copy"><strong>{entry.data.title.replace(/^Day \d+\s*[—–-]\s*/, '')}</strong><small>{entry.data.description}</small></span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </main>
    <Footer />
    <script>
      const search = document.querySelector<HTMLInputElement>('#lesson-search');
      const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-lesson]'));
      const empty = document.querySelector<HTMLElement>('.no-results');
      search?.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        let shown = 0;
        for (const row of rows) {
          const matches = (row.dataset.search ?? '').includes(q);
          row.hidden = !matches;
          if (matches) shown++;
        }
        if (empty) empty.hidden = shown !== 0;
      });
    </script>
  </body>
</html>
<style>
  .lesson-index { width:min(800px, calc(100% - 2rem)); max-width:none; padding:2.6rem 0 5rem; }
  .back { font-size:.8rem; text-decoration:none; font-weight:700; }
  .intro { margin:2rem 0 1.8rem; }
  .eyebrow { font-size:.7rem; font-weight:800; letter-spacing:.15em; color:#0f766e; }
  h1 { font-size:clamp(2rem,5vw,3.3rem); letter-spacing:-.04em; margin:.45rem 0; }
  .intro > p:last-child { font-size:.95rem; color:#64748b; max-width:600px; }
  .search-label { display:block; font-size:.82rem; font-weight:700; margin-bottom:.4rem; }
  input[type="search"] { box-sizing:border-box; width:100%; border-radius:.65rem; border:1px solid #cbd5e1; background:white; padding:.85rem 1rem; color:#0f172a; font:inherit; font-size:.9rem; }
  input:focus { outline:3px solid #99f6e4; border-color:#0f766e; }
  ol { list-style:none; padding:0; margin:1.5rem 0 0; display:flex; flex-direction:column; gap:.65rem; }
  li { border:1px solid #e2e8f0; background:white; border-radius:.7rem; }
  li[hidden] { display:none; }
  li a { display:flex; align-items:center; gap:1rem; padding:1rem; text-decoration:none; color:#0f172a; }
  li:hover { border-color:#5eead4; }
  .num { color:#0f766e; font-size:.82rem; font-weight:800; min-width:2rem; }
  .copy { display:flex; flex-direction:column; gap:.2rem; flex:1; }
  .copy strong { font-size:.95rem; line-height:1.4; }
  .copy small { color:#64748b; font-size:.78rem; line-height:1.5; }
  .arrow { color:#0f766e; }
  .no-results { font-size:.85rem; color:#64748b; }
</style>
