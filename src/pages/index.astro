---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const lessons = (await getCollection('blog'))
  .filter((entry) => /^day-\d+$/.test(entry.id))
  .sort((a, b) => a.id.localeCompare(b.id));
const latest = lessons.at(-1);
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/></head>
  <body>
    <Header />
    <main class="home">
      <section class="hero">
        <span class="eyebrow">BUILD A SERVICE · LEARN THE LANGUAGE</span>
        <h1>Learn Go by <em>building</em> something real.</h1>
        <p>A daily learning journal for experienced developers. Short explanations, hands-on exercises and Go idioms, all connected through one job-processing service.</p>
        <div class="actions">
          <a class="primary" href="/blog/">Explore lessons →</a>
          {latest && <a class="secondary" href={'/blog/' + latest.id + '/'}>Latest: Day {Number(latest.id.slice(4))} ↗</a>}
        </div>
      </section>

      <section class="summary" aria-label="Curriculum overview">
        <div><strong>{lessons.length.toString().padStart(2, '0')}</strong><span>Lessons drafted</span></div>
        <div><strong>20–30<span class="unit"> min</span></strong><span>Per lesson</span></div>
        <div><strong>01</strong><span>Running project</span></div>
      </section>

      <section class="curriculum">
        <div class="section-heading">
          <div><span class="eyebrow">THE CURRICULUM</span><h2>Start here, revisit anytime.</h2></div>
          <a href="/blog/">View all lessons →</a>
        </div>
        <div class="lesson-grid">
          {lessons.map((entry, index) => (
            <a class="lesson-card" href={'/blog/' + entry.id + '/'}>
              <span class="lesson-day">DAY {String(index + 1).padStart(2, '0')}</span>
              <h3>{entry.data.title.replace(/^Day \d+\s*[—–-]\s*/, '')}</h3>
              <p>{entry.data.description}</p>
              <span class="read-more">Read lesson <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      </section>
      <section class="note"><h2>Learn, don't just read.</h2><p>Every lesson ends with an exercise, acceptance criteria and an optional stretch challenge. Lessons are reference material, not a claim that you completed the exercises.</p></section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .home { width:min(1100px, calc(100% - 2rem)); max-width:none; padding:3.5rem 0 5rem; }
  .hero { max-width:790px; padding:2.8rem 0 3rem; }
  .eyebrow { display:block; color:#0f766e; font-size:0.76rem; font-weight:800; letter-spacing:0.14em; text-transform:uppercase; }
  h1 { font-size:clamp(2.5rem,6vw,4.75rem); letter-spacing:-0.055em; line-height:1.08; margin:0.8rem 0 1.3rem; }
  h1 em { font-style:normal; color:#0f766e; }
  .hero p { color:#475569; font-size:1.08rem; max-width:660px; }
  .actions { display:flex; gap:0.8rem; flex-wrap:wrap; margin-top:1.8rem; }
  .actions a { display:inline-flex; align-items:center; border-radius:0.7rem; padding:0.78rem 1.15rem; font-size:0.92rem; font-weight:700; text-decoration:none; }
  .primary { background:#0f766e; color:white; }
  .primary:hover { background:#115e59; color:white; }
  .secondary { color:#0f766e; border:1px solid #99f6e4; background:white; }
  .summary { display:grid; grid-template-columns:repeat(3,1fr); border:1px solid #e2e8f0; border-radius:1rem; background:#fff; overflow:hidden; }
  .summary div { display:flex; flex-direction:column; padding:1.4rem 1.8rem; border-right:1px solid #e2e8f0; }
  .summary div:last-child { border:0; }
  .summary strong { color:#0f172a; font-size:1.8rem; line-height:1.2; }
  .summary .unit { font-size:0.85rem; }
  .summary div > span { font-size:0.79rem; color:#64748b; }
  .curriculum { margin-top:4rem; }
  .section-heading { display:flex; align-items:end; justify-content:space-between; gap:1rem; margin-bottom:1.3rem; }
  .section-heading h2 { font-size:clamp(1.6rem,3vw,2rem); letter-spacing:-0.04em; margin:0.45rem 0 0; }
  .section-heading > a { white-space:nowrap; font-size:0.9rem; font-weight:700; text-decoration:none; }
  .lesson-grid { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:1rem; }
  .lesson-card { display:flex; flex-direction:column; gap:0.75rem; padding:1.5rem; background:white; border:1px solid #e2e8f0; border-radius:0.9rem; text-decoration:none; color:#0f172a; transition:transform .18s,box-shadow .18s; }
  .lesson-card:hover { transform:translateY(-3px); box-shadow:0 10px 25px #0f172a12; }
  .lesson-day { font-size:0.73rem; color:#0f766e; font-weight:800; letter-spacing:.12em; }
  .lesson-card h3 { font-size:1.16rem; line-height:1.3; margin:0; }
  .lesson-card p { font-size:0.83rem; color:#64748b; line-height:1.55; margin:0; flex:1; }
  .read-more { font-size:0.79rem; font-weight:700; color:#0f766e; margin-top:0.35rem; }
  .note { margin-top:3rem; padding:1.4rem 1.6rem; background:#ecfdf5; border-radius:0.9rem; border:1px solid #ccfbf1; }
  .note h2 { font-size:1.15rem; margin:0 0 0.2rem; }
  .note p { color:#475569; font-size:0.86rem; margin:0; }
  @media (max-width:800px) { .lesson-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:560px) { .home { padding-top:1.3rem; } .hero { padding:1.5rem 0 2rem; } .lesson-grid { grid-template-columns:1fr; } .summary div { padding:1rem; } .summary strong { font-size:1.3rem; } .section-heading { align-items:start; flex-direction:column; } }
</style>
