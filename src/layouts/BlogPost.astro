---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const currentId = Astro.url.pathname.split('/').filter(Boolean).at(-1);
const lessons = (await getCollection('blog')).filter((entry) => /^day-\d+$/.test(entry.id)).sort((a, b) => a.id.localeCompare(b.id));
const index = lessons.findIndex((entry) => entry.id === currentId);
const previous = index > 0 ? lessons[index - 1] : null;
const next = index >= 0 && index < lessons.length - 1 ? lessons[index + 1] : null;
---

<html lang="en">
  <head><BaseHead title={title + ' | Go Journey'} description={description}/></head>
  <body>
    <Header />
    <main class="post">
      <article>
        <div class="article-top"><a class="back" href="/blog/">← All lessons</a><span>GO JOURNEY</span></div>
        {heroImage && <Image class="hero-image" width={1020} height={510} src={heroImage} alt=""/>}
        <header class="article-header">
          <h1>{title}</h1>
          <p class="description">{description}</p>
          <p class="date"><FormattedDate date={pubDate}/>{updatedDate && <> · Updated <FormattedDate date={updatedDate}/></>}</p>
        </header>
        <div class="prose"><slot /></div>
      </article>
      {index >= 0 && <nav class="lesson-nav" aria-label="Previous and next lessons">
        {previous ? <a href={'/blog/' + previous.id + '/'}><small>← Previous lesson</small><strong>{previous.data.title}</strong></a> : <span></span>}
        {next ? <a href={'/blog/' + next.id + '/'}><small>Next lesson →</small><strong>{next.data.title}</strong></a> : <span></span>}
      </nav>}
    </main>
    <Footer/>
  </body>
</html>
<style>
  .post { width:min(800px, calc(100% - 2rem)); max-width:none; padding:2.2rem 0 4rem; }
  .article-top { display:flex; align-items:center; justify-content:space-between; gap:1rem; font-size:.72rem; font-weight:800; letter-spacing:.1em; color:#0f766e; }
  .back { text-decoration:none; font-size:.8rem; letter-spacing:normal; }
  .hero-image { width:100%; border-radius:.75rem; }
  .article-header { padding:2rem 0 1rem; border-bottom:1px solid #e2e8f0; margin-bottom:1.7rem; }
  h1 { font-size:clamp(2rem,5vw,3.2rem); letter-spacing:-.045em; margin-bottom:.8rem; }
  .description { font-size:1rem; color:#475569; line-height:1.55; margin:.5rem 0 1rem; }
  .date { color:#64748b; font-size:.75rem; }
  .prose { font-size:.95rem; line-height:1.8; color:#334155; }
  .prose :global(h2) { font-size:1.55rem; margin:2.3rem 0 .8rem; letter-spacing:-.02em; }
  .prose :global(h3) { font-size:1.2rem; margin:1.8rem 0 .7rem; }
  .prose :global(pre) { overflow-x:auto; font-size:.83rem; padding:1.1rem; border:1px solid #dbe4ef; }
  .prose :global(p) { margin:0 0 1.2rem; }
  .prose :global(li) { margin-bottom:.4rem; }
  .prose :global(code) { overflow-wrap:anywhere; }
  .lesson-nav { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-top:3rem; border-top:1px solid #e2e8f0; padding-top:1.5rem; }
  .lesson-nav a { display:flex; flex-direction:column; padding:1rem; background:white; border:1px solid #e2e8f0; border-radius:.75rem; text-decoration:none; gap:.35rem; }
  .lesson-nav a:hover { border-color:#0d9488; }
  .lesson-nav small { color:#0f766e; font-size:.72rem; font-weight:800; }
  .lesson-nav strong { color:#0f172a; font-size:.85rem; line-height:1.35; }
  @media (max-width:600px) { .lesson-nav { grid-template-columns:1fr; } }
</style>
